{
  "name": "@sandsoftwaresolutions/git-info",
  "version": "0.1.0",
  "description": "Commit, branch, tag and dirty state for build stamps, and a readable version from git tags. Never throws, never leaks credentials.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "git",
    "version",
    "build",
    "stamp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandSoftwareSolutions/ss-git-info.git"
  },
  "bugs": {
    "url": "https://github.com/SandSoftwareSolutions/ss-git-info/issues"
  },
  "homepage": "https://github.com/SandSoftwareSolutions/ss-git-info#readme",
  "publishConfig": {
    "access": "public"
  }
}
